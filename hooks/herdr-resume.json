{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.config/herdr-app/grok-resume/resume.py\" note",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.config/herdr-app/grok-resume/resume.py\" note",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.config/herdr-app/grok-resume/resume.py\" end",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
